# SehatSanketh AI Healthcare Platform Environment Configuration
# Copy this file to .env and insert your API keys

# Groq LPU API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI API Key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_key_here
